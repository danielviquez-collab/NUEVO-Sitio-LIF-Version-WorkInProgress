# Public build configuration; never commit .env.local.
LIF_BLOCK_CONFESSIONS_CONTENT=true
LIF_CLIENT_PREVIEW=true
LIF_LOCAL_GAME_TESTING=0
NEXT_PUBLIC_CONFESSIONS_ENDPOINT=https://script.google.com/macros/s/AKfycbySf1maD-ykcOREs1cKJfzjQ08Io-n8mDglQBCBj6LjSFdTSH6tymXPv4tUKDbOln_LIw/exec

# Set private server values in the destination environment, not Git.
LIF_GAME_STORAGE=postgres
LIF_DATABASE_HOST=
LIF_DATABASE_USER=
LIF_DATABASE_PASSWORD=
LIF_SHEETS_ENDPOINT=
LIF_SHEETS_SYNC_KEY=
